# FastAPI backend base URL (local dev or the Railway deployment)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Stripe publishable key for payment processing (test or production)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Optional dev flag: set to 1 to drive the Chat screen from a scripted mock
# event stream (lib/mockStream.ts) instead of calling POST /chat/stream, so
# the chat UI can be built/tested before the backend endpoint is ready.
# EXPO_PUBLIC_CHAT_MOCK=1

# Veda chat: predefined contact for WhatsApp share (POC)
EXPO_PUBLIC_VEDA_CONTACT_NAME=Friend
EXPO_PUBLIC_VEDA_CONTACT_PHONE=+919876543210

# Optional dev flag: set to 1 to show the "Integrations (Dev)" entry in the
# dashboard avatar menu -- a catalog of every planned third-party integration
# with standalone test actions, hidden from normal users when unset.
# EXPO_PUBLIC_ENABLE_DEV_CATALOG=1
