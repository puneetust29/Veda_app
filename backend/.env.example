# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
# Available models: claude-haiku-4-5-20251001 (fast & cheap), claude-sonnet-5 (better quality)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Google Calendar (optional — /calendar/google/* returns 503 until both are set).
# Create a Web-type OAuth client in the Google Cloud Console and add
# GOOGLE_REDIRECT_URI below as an Authorized redirect URI, exactly.
# Uncomment and fill in with real values. Left commented so that copying this
# file yields a cleanly *unconfigured* backend (503 on /calendar/google/*)
# rather than one that claims to be configured and fails against Google.
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-web-client-secret

# Google must be able to reach this, and it must match a registered Authorized
# redirect URI character for character. `localhost` resolves to the *device*, so
# it only works where the device and the backend are the same host — the iOS
# simulator. An Android emulator needs http://10.0.2.2:8000/..., and a physical
# phone needs your machine's LAN IP or the deployed HTTPS URL. Register every
# variant you intend to use, and set this to the one this backend answers on.
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/google/callback
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events

# Fallback deep link the OAuth callback page bounces back to, so the mobile
# in-app browser closes itself instead of stranding the user on a web page. The
# app normally sends its own per-runtime return URL (exp:// under Expo Go,
# veda:// in a dev/standalone build) and that takes precedence; this is only used
# on error paths, where there is no handshake left to read it from. Must match
# the `scheme` in mobile/app.json.
GOOGLE_POST_AUTH_REDIRECT=veda://google-calendar

# App
ENVIRONMENT=development
CORS_ORIGINS=*
